  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "seed": "tsx scripts/seed.ts",
    "seed:demo-accounts": "tsx scripts/seed-demo-accounts.ts",
    "db:validate": "prisma validate --config prisma7.config.ts",
    "db:generate": "prisma generate --config prisma7.config.ts",
    "db:migrate": "prisma migrate dev --config prisma7.config.ts",
    "db:resolve": "prisma migrate resolve --rolled-back 20261023062030_add_question_attempt_limit --config prisma7.config.ts || true",
    "db:deploy": "npm run db:resolve && prisma migrate deploy --config prisma7.config.ts",
    "studio": "prisma studio --config prisma7.config.ts"
  },
