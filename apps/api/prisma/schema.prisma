// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  VICE_CHANCELLOR
  HOD
  FACULTY
  STUDENT
}

enum LabLanguage {
  C
  CPP
  JAVA
  PYTHON
}

enum SubmissionStatus {
  PENDING
  RUNNING
  ACCEPTED
  WRONG_ANSWER
  COMPILATION_ERROR
  RUNTIME_ERROR
  TIME_LIMIT_EXCEEDED
  MEMORY_LIMIT_EXCEEDED
  INTERNAL_ERROR
}

enum QuestionType {
  DAILY
  PRACTICE
}

model Department {
  id          String   @id @default(cuid())
  name        String
  code        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]
  labs        Lab[]
  institutionId String?
  institution Institution? @relation(fields: [institutionId], references: [id], onDelete: SetNull)
  programs    Program[]
  courses     Course[]
  facultyProfiles FacultyProfile[]

  @@index([institutionId])
}

model Institution {
  id        String       @id @default(cuid())
  name      String
  code      String       @unique
  departments Department[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

model Program {
  id           String       @id @default(cuid())
  name         String
  code         String
  departmentId String
  department   Department   @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  cohorts      Cohort[]
  students     StudentProfile[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@unique([departmentId, code])
  @@index([departmentId])
}

model AcademicYear {
  id        String   @id @default(cuid())
  label     String   @unique
  startsOn  DateTime?
  endsOn    DateTime?
  cohorts   Cohort[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Cohort {
  id              String       @id @default(cuid())
  programId       String
  academicYearId  String
  semester        Int
  section         String
  program         Program      @relation(fields: [programId], references: [id], onDelete: Restrict)
  academicYear    AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  students        StudentProfile[]
  labs            Lab[]
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([programId, academicYearId, semester, section])
  @@index([academicYearId, semester])
}

model StudentProfile {
  id               String   @id @default(cuid())
  userId           String   @unique
  enrollmentNumber String   @unique
  instituteId      String?
  programId        String?
  cohortId         String?
  isActive         Boolean  @default(true)
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  program          Program? @relation(fields: [programId], references: [id], onDelete: SetNull)
  cohort           Cohort?  @relation(fields: [cohortId], references: [id], onDelete: SetNull)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([programId])
  @@index([cohortId])
  @@index([isActive])
}

model FacultyProfile {
  id           String     @id @default(cuid())
  userId       String     @unique
  designation  String?
  departmentId String?
  isActive     Boolean    @default(true)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  courseAssignments CourseFacultyAssignment[]
  labAssignments LabFacultyAssignment[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([departmentId])
}

model Course {
  id           String     @id @default(cuid())
  code         String
  title        String
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  labs         Lab[]
  facultyAssignments CourseFacultyAssignment[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([departmentId, code])
  @@index([departmentId])
}

model CourseFacultyAssignment {
  courseId  String
  facultyId String
  course    Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  faculty   FacultyProfile @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  assignedAt DateTime     @default(now())

  @@id([courseId, facultyId])
  @@index([facultyId])
}

model LabFacultyAssignment {
  labId      String
  facultyId  String
  lab        Lab           @relation(fields: [labId], references: [id], onDelete: Cascade)
  faculty    FacultyProfile @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  assignedAt DateTime      @default(now())

  @@id([labId, facultyId])
  @@index([facultyId])
}

model User {
  id             String         @id @default(cuid())
  name           String
  email          String         @unique
  passwordHash   String
  isActive       Boolean        @default(true)
  role           Role           @default(STUDENT)
  rollNumber     String?
  departmentId   String?
  department     Department?    @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  createdLabs    Lab[]          @relation("LabCreator")
  labEnrollments Enrollment[]   @relation("StudentEnrollments")
  submissions    Submission[]
  notifications  Notification[]
  auditLogs      AuditLog[]
  studentProfile StudentProfile?
  facultyProfile FacultyProfile?

  @@index([departmentId])
  @@index([role])
}

model Lab {
  id            String         @id @default(cuid())
  title         String
  code          String?
  description   String?
  language      LabLanguage
  enrollmentKey String?        @unique
  isPublished   Boolean        @default(false)

  departmentId  String?
  department    Department?    @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  courseId      String?
  course        Course?        @relation(fields: [courseId], references: [id], onDelete: SetNull)
  cohortId      String?
  cohort        Cohort?        @relation(fields: [cohortId], references: [id], onDelete: SetNull)
  facultyAssignments LabFacultyAssignment[]

  createdById   String
  createdBy     User           @relation("LabCreator", fields: [createdById], references: [id], onDelete: Restrict)

  enrollments   Enrollment[]
  questions     Question[]
  examinations  Examination[]
  submissions   Submission[]

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  archivedAt    DateTime?      @db.Timestamp(3)

  @@index([departmentId])
  @@index([createdById])
  @@index([courseId])
  @@index([cohortId])
  @@index([isPublished])
  @@index([archivedAt])
}

model Enrollment {
  id         String   @id @default(cuid())
  studentId  String
  labId      String

  student    User     @relation("StudentEnrollments", fields: [studentId], references: [id], onDelete: Cascade)
  lab        Lab      @relation(fields: [labId], references: [id], onDelete: Cascade)

  enrolledAt DateTime @default(now())

  @@unique([studentId, labId])
  @@index([studentId])
  @@index([labId])
}

model Question {
  id                   String                @id @default(cuid())
  labId                String
  lab                  Lab                   @relation(fields: [labId], references: [id], onDelete: Cascade)
  contentType          QuestionType          @default(PRACTICE)
  isPublished          Boolean               @default(true)
  availableFrom        DateTime?             @db.Timestamp(3)
  availableUntil       DateTime?             @db.Timestamp(3)
  title                String
  description          String
  inputFormat          String?
  outputFormat         String?
  constraints          String?
  difficulty           String                @default("MEDIUM")
  marks                Int                   @default(10)
  timeLimitMs          Int                   @default(2000)
  memoryLimitMb        Int                   @default(128)
  attemptsAllowed      Int?
  starterCode          String?
  orderIndex           Int                   @default(0)

  testCases            TestCase[]
  submissions          Submission[]
  examinationQuestions ExaminationQuestion[]

  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  @@index([labId])
  @@index([orderIndex])
  @@index([isPublished, availableFrom, availableUntil])
}

model TestCase {
  id             String                 @id @default(cuid())
  questionId     String
  question       Question               @relation(fields: [questionId], references: [id], onDelete: Cascade)
  input          String
  expectedOutput String
  isHidden       Boolean                @default(false)
  explanation    String?
  orderIndex     Int                    @default(0)

  results        SubmissionTestResult[]

  @@index([questionId])
  @@index([orderIndex])
}

model Examination {
  id               String                @id @default(cuid())
  labId            String
  lab              Lab                   @relation(fields: [labId], references: [id], onDelete: Cascade)
  title            String
  description      String?
  startTime        DateTime
  endTime          DateTime
  durationMinutes  Int                   @default(60)
  totalMarks       Int                   @default(100)
  isPublished      Boolean               @default(false)
  disableCopyPaste Boolean               @default(false)

  questions        ExaminationQuestion[]
  submissions      Submission[]

  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  @@index([labId])
  @@index([startTime, endTime])
  @@index([isPublished])
}

model ExaminationQuestion {
  id            String      @id @default(cuid())
  examinationId String
  questionId    String
  orderIndex    Int         @default(0)

  examination   Examination @relation(fields: [examinationId], references: [id], onDelete: Cascade)
  question      Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([examinationId, questionId])
  @@index([examinationId])
  @@index([questionId])
}

model Submission {
  id             String                 @id @default(cuid())
  studentId      String
  student        User                   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  labId          String
  lab            Lab                    @relation(fields: [labId], references: [id], onDelete: Cascade)
  questionId     String
  question       Question               @relation(fields: [questionId], references: [id], onDelete: Cascade)
  examinationId  String?
  examination    Examination?           @relation(fields: [examinationId], references: [id], onDelete: SetNull)

  language       LabLanguage
  sourceCode     String
  status         SubmissionStatus       @default(PENDING)
  compileOutput  String?
  score          Float                  @default(0)
  totalTests     Int                    @default(0)
  passedTests    Int                    @default(0)
  executionTimeMs Int?

  testResults    SubmissionTestResult[]

  submittedAt    DateTime               @default(now())

  @@index([studentId])
  @@index([labId])
  @@index([questionId])
  @@index([examinationId])
  @@index([submittedAt])
  @@index([status])
}

model SubmissionTestResult {
  id              String           @id @default(cuid())
  submissionId    String
  submission      Submission       @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  testCaseId      String
  testCase        TestCase         @relation(fields: [testCaseId], references: [id], onDelete: Cascade)

  passed          Boolean
  status          SubmissionStatus
  actualOutput    String?
  executionTimeMs Int?

  @@index([submissionId])
  @@index([testCaseId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String   @default("INFO")
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String?
  details   String?
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
  @@index([action])
}
