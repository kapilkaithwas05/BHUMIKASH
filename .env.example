# =============================================================================
# LabNEXUS — Environment Configuration Template
# =============================================================================

# Server Port
PORT=5000

# PostgreSQL Database Connection
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/labnexus?schema=public"

# JWT Secret for Token Issuance & Verification
JWT_SECRET=your_super_secret_jwt_key_here_minimum_32_characters

# Optional local execution-tool override. Leave empty for auto-discovery.
# This does not make the host runner safe for untrusted code.
PYTHON_EXECUTABLE=

# Optional: Redis Configuration for BullMQ Workers
REDIS_HOST=localhost
REDIS_PORT=6379

# Optional: University Attendance Management System (AMS) Gateway
AMS_API_GATEWAY_URL=
AMS_API_KEY=
